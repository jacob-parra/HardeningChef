{% set p = cfg.packages %}
# ------------------------------------------------------------------ packages --
{% if os.family == "debian" %}
apt_source_files() {
  local f
  for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
    [ -f "$f" ] && printf '%s\n' "$f"
  done
}

# Disable one APT source file. deb822 (.sources) gets "Enabled: no" in every
# stanza; one-line files (.list) get their deb lines commented out.
disable_apt_source() {
  local name=$1 path
  if [ "$name" = sources.list ]; then path=/etc/apt/sources.list; else path=/etc/apt/sources.list.d/$name; fi
  [ -f "$path" ] || { warn "APT source $path not found; skipped"; return 0; }
  case "$path" in
    *.sources)
      awk 'BEGIN { fresh = 1 }
           /^[ \t]*$/ { print; fresh = 1; next }
           /^[ \t]*#/ { print; next }
           tolower($1) == "enabled:" { next }
           { if (fresh) { print "Enabled: no"; fresh = 0 } print }' "$path" | write_file "$path" "$(stat -c %a "$path")" ;;
    *)
      sed -E 's/^([[:space:]]*deb(-src)?[[:space:]])/# disabled by HardeningChef: \1/' "$path" | write_file "$path" "$(stat -c %a "$path")" ;;
  esac
}

# Remove the given components from every source.
strip_components() {
  local comps="$*" f
  while IFS= read -r f; do
    case "$f" in
      *.sources)
        awk -v c="$comps" '
          BEGIN { n = split(c, a, " "); for (i = 1; i <= n; i++) rm[a[i]] = 1 }
          tolower($1) == "components:" {
            out = $1; kept = 0
            for (i = 2; i <= NF; i++) if (!($i in rm)) { out = out " " $i; kept++ }
            if (kept) print out; else { print; print "Enabled: no" }
            next
          }
          { print }' "$f" ;;
      *)
        awk -v c="$comps" '
          BEGIN { n = split(c, a, " "); for (i = 1; i <= n; i++) rm[a[i]] = 1 }
          /^[ \t]*deb(-src)?[ \t]/ {
            i = 2
            if ($2 ~ /^\[/) { while (i <= NF && $i !~ /\]$/) i++; i++ }
            out = $1; for (j = 2; j <= i + 1; j++) out = out " " $j
            kept = 0
            for (j = i + 2; j <= NF; j++) if (!($j in rm)) { out = out " " $j; kept++ }
            if (kept) print out; else print "# HardeningChef removed all components: " $0
            next
          }
          { print }' "$f" ;;
    esac | write_file "$f" "$(stat -c %a "$f")"
  done < <(apt_source_files)
}

# Installed packages no enabled source provides. Never lists kernels or
# packages the system needs to boot (Essential, or Priority required/important).
orphan_packages() {
  local -A keep=()
  local name ess prio
  while read -r name ess prio; do
    [[ $ess == yes || $prio == required || $prio == important ]] && keep[$name]=1
  done < <(dpkg-query -W -f='${Package} ${Essential} ${Priority}\n' 2>/dev/null)
  apt list --installed 2>/dev/null | awk -F/ '/local\]/ { print $1 }' | grep -vE '^(linux-|kernel)' |
    while read -r name; do [ -z "${keep[$name]:-}" ] && printf '%s\n' "$name"; done
}

apt_lists_present() { compgen -G '/var/lib/apt/lists/*_Packages' >/dev/null || compgen -G '/var/lib/apt/lists/*_Packages.*' >/dev/null; }
{% else %}
disable_dnf_repo() {
  local id=$1 f
  f=$(awk -v id="[$id]" '$1 == id { print FILENAME; exit }' /etc/yum.repos.d/*.repo 2>/dev/null)
  if [ -z "$f" ]; then warn "DNF repository '$id' not found; skipped"; return 0; fi
  if dnf --version 2>/dev/null | grep -qi dnf5; then
    run dnf config-manager setopt "$id.enabled=0"
  else
    awk -v id="[$id]" '
      $0 == id { insec = 1; print; next }
      /^\[/ { if (insec && !done) print "enabled=0"; insec = 0; done = 0; print; next }
      insec && /^[ \t]*enabled[ \t]*=/ { if (!done) print "enabled=0"; done = 1; next }
      { print }
      END { if (insec && !done) print "enabled=0" }' "$f" | write_file "$f" "$(stat -c %a "$f")"
  fi
}

orphan_packages() {
  dnf list --extras 2>/dev/null | awk 'NF == 3 && $1 ~ /\./ { sub(/\.[^.]+$/, "", $1); print $1 }' | grep -vE '^(kernel|linux-)' || true
}
{% endif %}

pkg_remove_confirm() {
  local what=$1; shift
  local -a pkgs=()
  local x; for x in "$@"; do pkg_is_installed "$x" && pkgs+=("$x"); done
  (( ${#pkgs[@]} )) || { ok "$what: nothing installed"; return 0; }
{% if os.family == "debian" %}
  info "$what: removing ${pkgs[*]} would also remove:"
  apt-get -s remove "${pkgs[@]}" 2>/dev/null | awk '/^Remv/ { print "            " $2 }'
  confirm "Remove ${pkgs[*]}?" && run apt-get remove -y -q "${pkgs[@]}"
{% else %}
  info "$what: removal transaction for ${pkgs[*]}:"
  dnf remove --assumeno "${pkgs[@]}" 2>/dev/null | sed -n '/^Removing/,/^Transaction Summary/p' | sed 's/^/            /'
  confirm "Remove ${pkgs[*]}?" && run dnf remove -y -q "${pkgs[@]}"
{% endif %}
}

hc_packages() {
  section "Package management ({{ "APT" if os.family == "debian" else "DNF" }})"
{% if os.family == "debian" %}
  local touched=0
{% for src in p.apt_disable_sources %}
  disable_apt_source {{ src|q }}; touched=1
{% endfor %}
{% if p.apt_disable_components %}
  strip_components {{ p.apt_disable_components|qlist }}; touched=1
{% endif %}
  (( touched && HC_APPLY )) && run apt-get update -q
{% else %}
{% for repo in p.dnf_disable_repos %}
  disable_dnf_repo {{ repo|q }}
{% endfor %}
{% if p.dnf_disable_repos %}
  (( HC_APPLY )) && run dnf makecache -q
{% endif %}
{% endif %}

{% if p.remove_orphaned %}
  local -a orphans=()
{% if os.family == "debian" %}
  if apt_lists_present; then mapfile -t orphans < <(orphan_packages)
  else warn "APT package lists are empty (run apt-get update); cannot tell which packages lack a source"; fi
{% else %}
  mapfile -t orphans < <(orphan_packages)
{% endif %}
  (( HC_APPLY )) || info "(audit mode lists packages without a source before any sources are disabled)"
  if (( ${#orphans[@]} > 25 && ! HC_FORCE )); then
    warn "${#orphans[@]} installed packages have no enabled source. That usually means a main OS repository was disabled, so nothing is removed. Review the list and re-run with --force to remove them anyway:"
    printf '            %s\n' "${orphans[@]:0:40}"
  elif (( ${#orphans[@]} )); then
    info "installed packages that no enabled source provides:"
    printf '            %s\n' "${orphans[@]}"
{% if os.family == "debian" %}
    confirm "Remove these ${#orphans[@]} packages?" && run apt-get remove -y -q "${orphans[@]}"
{% else %}
    confirm "Remove these ${#orphans[@]} packages?" && run dnf remove -y -q "${orphans[@]}"
{% endif %}
  else
    ok "every installed package comes from an enabled source"
  fi
{% endif %}

{% if p.remove_fuse2 %}
  pkg_remove_confirm "FUSE 2" {{ os.fuse2_packages|qlist }}
{% endif %}

{% if p.remove_flatpak %}
  if command -v flatpak >/dev/null 2>&1; then
    run flatpak uninstall --system --all --noninteractive -y
    local u
    while read -r u; do
      [ -d "$(home_of "$u")/.local/share/flatpak/app" ] && run runuser -u "$u" -- flatpak uninstall --user --all --noninteractive -y
    done < <(human_users)
  fi
  pkg_remove_confirm "Flatpak" flatpak
{% if os.family == "debian" %}
  write_file /etc/apt/preferences.d/hardeningchef-no-flatpak <<'HC_EOF'
# Managed by HardeningChef: block Flatpak from being reinstalled.
Package: flatpak libflatpak*
Pin: release a=*
Pin-Priority: -1
HC_EOF
{% else %}
  if grep -qE '^excludepkgs=.*flatpak' /etc/dnf/dnf.conf 2>/dev/null; then
    ok "flatpak already excluded in /etc/dnf/dnf.conf"
  elif grep -qE '^excludepkgs=' /etc/dnf/dnf.conf 2>/dev/null; then
    sed -E 's/^(excludepkgs=.*)$/\1,flatpak*/' /etc/dnf/dnf.conf | write_file /etc/dnf/dnf.conf
  else
    { cat /etc/dnf/dnf.conf 2>/dev/null || echo '[main]'; echo 'excludepkgs=flatpak*'; } | write_file /etc/dnf/dnf.conf
  fi
{% endif %}
{% endif %}
  return 0
}
